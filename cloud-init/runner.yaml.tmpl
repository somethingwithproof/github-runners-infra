#cloud-config

ssh_pwauth: false
disable_root: true

users:
  # Docker group membership is intentionally root-equivalent. Each runner is
  # single-use, receives no controller credentials, and is destroyed after one
  # trusted private-repository job; sudo removal is not a job/host boundary.
  - name: runner
    shell: /bin/bash
    groups: docker

{{- if not .PrebakedImage}}
apt:
  primary:
    - arches: [default]
      uri: https://archive.ubuntu.com/ubuntu
  security:
    - arches: [default]
      uri: https://security.ubuntu.com/ubuntu

package_update: true

packages:
  - docker.io
  - build-essential
  - ca-certificates
  - curl
  - git
  - jq
  - unzip
  - libyaml-dev
  - libssl-dev
  - zlib1g-dev
{{- end}}

runcmd:
  - |
    set -eu
    {{- if gt .DeadmanShutdownMinutes 0}}
    # Secret-free in-VM dead-man shutdown fuse: guarantees compute stops even
    # if the runner hangs or loses GitHub connectivity. No cloud API token is
    # placed in user data; on providers that bill powered-off VMs (such as
    # DigitalOcean, Vultr, and Linode), the controller's age-gated sweep still
    # destroys the stopped instance after MAX_RUNNER_AGE.
    unit=/etc/systemd/system/runner-deadman-shutdown
    if [ ! -f "$unit.timer" ]; then
      deadline=$(date -u -d '+{{.DeadmanShutdownMinutes}} minutes' '+%Y-%m-%d %H:%M:%S UTC')
      printf '%s\n' '[Service]' 'Type=oneshot' 'ExecStart=/sbin/shutdown --poweroff now' > "$unit.service"
      printf '%s\n' '[Timer]' "OnCalendar=$deadline" 'Persistent=true' 'AccuracySec=1s' '[Install]' 'WantedBy=timers.target' > "$unit.timer.tmp"
      mv "$unit.timer.tmp" "$unit.timer"
    fi
    systemctl daemon-reload
    systemctl enable --now runner-deadman-shutdown.timer
    {{- end}}
    systemctl enable --now docker
    {{- if .EgressAllowlist}}

    # The administrator-controlled network firewall enforces workload isolation.
    # This optional host policy restricts ordinary host processes on both IP families.
    for filter in iptables ip6tables; do
      "$filter" -N RUNNER_HTTPS 2>/dev/null || "$filter" -F RUNNER_HTTPS
      "$filter" -A RUNNER_HTTPS -o lo -j ACCEPT
      "$filter" -A RUNNER_HTTPS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
      "$filter" -A RUNNER_HTTPS -p udp --dport 53 -j ACCEPT
      "$filter" -A RUNNER_HTTPS -p tcp --dport 53 -j ACCEPT
    done
    # IPv6 neighbor discovery is required on the link.
    for kind in neighbor-solicitation neighbor-advertisement router-solicitation; do
      ip6tables -A RUNNER_HTTPS -p ipv6-icmp --icmpv6-type "$kind" -m hl --hl-eq 255 -j ACCEPT
    done
    {{- range .EgressAllowlist}}
    dest='{{.}}'
    case "$dest" in
      *:*) ip6tables -A RUNNER_HTTPS -p tcp --dport 443 -d "$dest" -j ACCEPT ;;
      */*) iptables -A RUNNER_HTTPS -p tcp --dport 443 -d "$dest" -j ACCEPT ;;
      *)
        for ip in $(getent ahosts "$dest" | awk '{print $1}' | sort -u); do
          case "$ip" in *:*) filter=ip6tables ;; *) filter=iptables ;; esac
          "$filter" -A RUNNER_HTTPS -p tcp --dport 443 -d "$ip" -j ACCEPT
        done ;;
    esac
    {{- end}}
    for filter in iptables ip6tables; do
      "$filter" -A RUNNER_HTTPS -j REJECT
      "$filter" -C OUTPUT -j RUNNER_HTTPS 2>/dev/null || "$filter" -I OUTPUT 1 -j RUNNER_HTTPS
    done
    {{- end}}

    {{- if not .PrebakedImage}}
    # Template sources and controller validation restrict these single-quoted
    # values to URLs, hex digests, versions, and base64 without apostrophes.
    # Revisit shell quoting before changing those sources or validators.
    CHEF_INSTALLER=/tmp/chef-install.sh
    CHEF_SHA256='{{.ChefInstallerSHA256}}'
    curl --fail --silent --show-error --location \
      --proto '=https' --tlsv1.2 \
      --output "$CHEF_INSTALLER" \
      https://omnitruck.chef.io/install.sh
    printf '%s  %s\n' "$CHEF_SHA256" "$CHEF_INSTALLER" | \
      sha256sum --check --strict -
    bash "$CHEF_INSTALLER" -P chef-workstation
    shred --remove "$CHEF_INSTALLER"

    install -d -o runner -g runner /opt/hostedtoolcache
    install -d -o runner -g runner /home/runner/actions-runner
    cd /home/runner/actions-runner

    RUNNER_TARBALL='actions-runner-linux-x64-{{.RunnerVersion}}.tar.gz'
    RUNNER_SHA256='{{.RunnerSHA256}}'
    RUNNER_RELEASE='https://github.com/actions/runner/releases/download'
    RUNNER_URL="${RUNNER_RELEASE}/v{{.RunnerVersion}}/${RUNNER_TARBALL}"
    curl --fail --silent --show-error --location \
      --proto '=https' --tlsv1.2 \
      --output "$RUNNER_TARBALL" \
      "$RUNNER_URL"
    printf '%s  %s\n' "$RUNNER_SHA256" "$RUNNER_TARBALL" | \
      sha256sum --check --strict -
    tar --extract --gzip --file "$RUNNER_TARBALL"
    shred --remove "$RUNNER_TARBALL"
    chown -R runner:runner /home/runner/actions-runner
    {{- else}}
    install -d -o runner -g runner /opt/hostedtoolcache
    cd /home/runner/actions-runner
    {{- end}}

    RUNNER_EXIT=0
    {{- if .RunnerJITConfig}}
    install -m 0600 -o runner -g runner /dev/null /home/runner/.jit-config
    printf '%s' '{{.RunnerJITConfig}}' > /home/runner/.jit-config
    JIT_CONFIG=$(cat /home/runner/.jit-config)
    shred --remove /home/runner/.jit-config

    runuser -u runner -- ./run.sh --jitconfig "$JIT_CONFIG" || RUNNER_EXIT=$?
    unset JIT_CONFIG
    {{- else if .RunnerRegistrationToken}}
    install -m 0600 -o runner -g runner /dev/null /home/runner/.reg-token
    printf '%s' '{{.RunnerRegistrationToken}}' > /home/runner/.reg-token
    REG_TOKEN=$(cat /home/runner/.reg-token)
    shred --remove /home/runner/.reg-token

    runuser -u runner -- ./config.sh --ephemeral --unattended \
      --url '{{.RunnerRepoURL}}' \
      --name '{{.RunnerName}}' \
      {{if .RegistrationLabels}}--labels '{{.LabelList}}' {{end}}--token "$REG_TOKEN"
    unset REG_TOKEN
    runuser -u runner -- ./run.sh || RUNNER_EXIT=$?
    {{- else}}
    echo "ERROR: neither JIT config nor registration token was provided" >&2
    RUNNER_EXIT=1
    {{- end}}

    # The trusted controller deletes the instance after the workflow_job
    # completion event. Power off immediately to stop workload execution while
    # waiting for that control-plane deletion or TTL reconciliation.
    shutdown --poweroff now
    exit "$RUNNER_EXIT"
